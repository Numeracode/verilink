FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/edge-verifier ./cmd/edge-verifier

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/edge-verifier /edge-verifier
USER nonroot
EXPOSE 8080
ENTRYPOINT ["/edge-verifier"]
