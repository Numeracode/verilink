FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/trust-engine ./cmd/trust-engine

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/trust-engine /trust-engine
USER nonroot
EXPOSE 9091 8086
ENTRYPOINT ["/trust-engine"]
