#!/usr/bin/env bash
set -euo pipefail

# VeriLink pre-push gate
# Runs: tests, build, vulnerability scan

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

failed=0

echo "Running pre-push gate..."

# 1. Full test suite
echo -n "  go test... "
if go test ./... 2>/dev/null; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    failed=1
fi

# 2. Build all binaries
echo -n "  go build... "
if go build ./... 2>/dev/null; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    failed=1
fi

# 3. Vulnerability scan
echo -n "  govulncheck... "
if command -v govulncheck &>/dev/null; then
    if govulncheck ./... 2>/dev/null; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC} — vulnerabilities found"
        failed=1
    fi
else
    echo -e "${YELLOW}SKIP${NC} — govulncheck not installed"
fi

if [ $failed -ne 0 ]; then
    echo -e "\n${RED}Pre-push gate FAILED${NC}"
    echo "Fix the issues above before pushing"
    exit 1
fi

echo -e "\n${GREEN}Pre-push gate PASSED${NC}"
