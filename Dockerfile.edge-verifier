FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/edge-verifier ./cmd/edge-verifier

FROM alpine:3.20
RUN addgroup -S app && adduser -S app -G app
COPY --from=build /out/edge-verifier /usr/local/bin/edge-verifier
USER app
EXPOSE 8080
CMD ["edge-verifier"]
